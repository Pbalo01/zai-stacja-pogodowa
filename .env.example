# Skopiuj do pliku .env (nie jest commitowany) i uzupełnij.
# Porty na hoście dla docker compose
APP_PORT=8080
DB_PORT=5433

# Hasło do lokalnej bazy PostgreSQL
POSTGRES_PASSWORD=app

# Sekret Symfony (dowolny losowy ciąg, np. `openssl rand -hex 16`)
APP_SECRET=

# Konto administratora tworzone przy starcie kontenera (app:create-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Adresy zaufanych proxy (na Render: REMOTE_ADDR)
TRUSTED_PROXIES=127.0.0.1

# Produkcja (Render + Neon): DATABASE_URL ustawiany bezpośrednio w panelu Render, np.
# DATABASE_URL=postgresql://user:haslo@ep-xxx.eu-central-1.aws.neon.tech/app?sslmode=require&serverVersion=16&charset=utf8
